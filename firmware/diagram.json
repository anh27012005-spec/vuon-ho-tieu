{
  "version": 1,
  "author": "Lab 3 - Vuon ca phe ho tieu",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -105, "left": -220, "attrs": { "temperature": "28", "humidity": "50" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 100, "left": -220, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": -30, "left": 200, "attrs": { "color": "blue", "label": "Phun suong" } },
    { "type": "wokwi-relay-module", "id": "relay1", "top": 240, "left": -320, "rotate": 180, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay2", "top": 260, "left": 180, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:SDA", "esp:15", "green", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:25", "r1:2", "blue", [ "h0" ] ],
    [ "r1:1", "led1:A", "blue", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "relay1:IN", "esp:26", "orange", [ "h0" ] ],
    [ "relay1:GND", "esp:GND.1", "black", [ "h0" ] ],
    [ "relay1:VCC", "esp:5V", "red", [ "h0" ] ],

    [ "relay2:IN", "esp:27", "purple", [ "h0" ] ],
    [ "relay2:GND", "esp:GND.1", "black", [ "h0" ] ],
    [ "relay2:VCC", "esp:5V", "red", [ "h0" ] ]
  ],
  "dependencies": {}
}
